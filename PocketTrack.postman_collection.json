{
  "info": {
    "name": "PocketTrack API Collection",
    "description": "Comprehensive Postman collection for testing PocketTrack Expense Tracker APIs including Auth, Transactions, Budgets, and Dashboard.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"PocketTrack@2026\",\n  \"confirm_password\": \"PocketTrack@2026\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["auth", "register", ""]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.tokens) {",
                  "    pm.collectionVariables.set('access_token', jsonData.tokens.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.tokens.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"PocketTrack@2026\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["auth", "login", ""]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh/",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh", ""]
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/profile/",
              "host": ["{{base_url}}"],
              "path": ["auth", "profile", ""]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Johnny\",\n  \"last_name\": \"Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/profile/",
              "host": ["{{base_url}}"],
              "path": ["auth", "profile", ""]
            }
          }
        }
      ]
    },
    {
      "name": "2. Transactions",
      "item": [
        {
          "name": "List Transactions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/transactions/?transaction_type=&category=&search=&ordering=newest",
              "host": ["{{base_url}}"],
              "path": ["transactions", ""],
              "query": [
                { "key": "transaction_type", "value": "" },
                { "key": "category", "value": "" },
                { "key": "search", "value": "" },
                { "key": "ordering", "value": "newest" }
              ]
            }
          }
        },
        {
          "name": "Create Income Transaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Monthly Salary\",\n  \"amount\": \"45000.00\",\n  \"transaction_type\": \"INCOME\",\n  \"category\": \"Salary\",\n  \"description\": \"Primary company salary deposit\",\n  \"transaction_date\": \"2026-09-01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/transactions/",
              "host": ["{{base_url}}"],
              "path": ["transactions", ""]
            }
          }
        },
        {
          "name": "Create Expense Transaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Supermarket Groceries\",\n  \"amount\": \"3200.00\",\n  \"transaction_type\": \"EXPENSE\",\n  \"category\": \"Food\",\n  \"description\": \"Vegetables and household staples\",\n  \"transaction_date\": \"2026-09-15\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/transactions/",
              "host": ["{{base_url}}"],
              "path": ["transactions", ""]
            }
          }
        },
        {
          "name": "Get Transaction Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/transactions/1/",
              "host": ["{{base_url}}"],
              "path": ["transactions", "1", ""]
            }
          }
        },
        {
          "name": "Update Transaction",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Grocery Bill\",\n  \"amount\": \"3500.00\",\n  \"transaction_type\": \"EXPENSE\",\n  \"category\": \"Food\",\n  \"description\": \"Revised total with receipts\",\n  \"transaction_date\": \"2026-09-15\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/transactions/1/",
              "host": ["{{base_url}}"],
              "path": ["transactions", "1", ""]
            }
          }
        },
        {
          "name": "Delete Transaction",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/transactions/1/",
              "host": ["{{base_url}}"],
              "path": ["transactions", "1", ""]
            }
          }
        },
        {
          "name": "Get Categories List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/transactions/categories/",
              "host": ["{{base_url}}"],
              "path": ["transactions", "categories", ""]
            }
          }
        }
      ]
    },
    {
      "name": "3. Budgets",
      "item": [
        {
          "name": "List Budgets",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/budgets/?month=9&year=2026",
              "host": ["{{base_url}}"],
              "path": ["budgets", ""],
              "query": [
                { "key": "month", "value": "9" },
                { "key": "year", "value": "2026" }
              ]
            }
          }
        },
        {
          "name": "Create Budget",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Food\",\n  \"amount\": \"6000.00\",\n  \"month\": 9,\n  \"year\": 2026\n}"
            },
            "url": {
              "raw": "{{base_url}}/budgets/",
              "host": ["{{base_url}}"],
              "path": ["budgets", ""]
            }
          }
        },
        {
          "name": "Get Budget Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/budgets/summary/?month=9&year=2026",
              "host": ["{{base_url}}"],
              "path": ["budgets", "summary", ""],
              "query": [
                { "key": "month", "value": "9" },
                { "key": "year", "value": "2026" }
              ]
            }
          }
        },
        {
          "name": "Update Budget",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Food\",\n  \"amount\": \"7500.00\",\n  \"month\": 9,\n  \"year\": 2026\n}"
            },
            "url": {
              "raw": "{{base_url}}/budgets/1/",
              "host": ["{{base_url}}"],
              "path": ["budgets", "1", ""]
            }
          }
        },
        {
          "name": "Delete Budget",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/budgets/1/",
              "host": ["{{base_url}}"],
              "path": ["budgets", "1", ""]
            }
          }
        }
      ]
    },
    {
      "name": "4. Dashboard & Reports",
      "item": [
        {
          "name": "Get Dashboard Overview",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/",
              "host": ["{{base_url}}"],
              "path": ["dashboard", ""]
            }
          }
        },
        {
          "name": "Get Reports (Current Month)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/reports/?period=current_month",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "reports", ""],
              "query": [
                { "key": "period", "value": "current_month" }
              ]
            }
          }
        },
        {
          "name": "Get Reports (Custom Month & Year)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/reports/?month=9&year=2026",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "reports", ""],
              "query": [
                { "key": "month", "value": "9" },
                { "key": "year", "value": "2026" }
              ]
            }
          }
        }
      ]
    }
  ]
}

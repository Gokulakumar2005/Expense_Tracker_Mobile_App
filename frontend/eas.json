{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_LIVE_API": "true",
        "EXPO_PUBLIC_API_URL": "https://expense-tracker-mobile-app-backend-j1ep.onrender.com/api"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_LIVE_API": "true",
        "EXPO_PUBLIC_API_URL": "https://expense-tracker-mobile-app-backend-j1ep.onrender.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

{
  "expo": {
    "name": "PocketTrack",
    "slug": "pockettrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gokulakumar.pockettrack",
      "adaptiveIcon": {
        "backgroundColor": "#2563EB"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "42e81254-a35f-4659-8bfe-335ad1f0145d"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
